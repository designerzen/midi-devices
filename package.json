{
	"name": "midi-devices",
	"version": "1.0.1",
	"description": "Open MIDI hardware profiles: controls, port names, panel diagrams, icons and setup notes for MIDI devices",
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./device-files.js": "./index.js",
		"./client.js": "./client.js",
		"./index.json": "./devices/index.json",
		"./manufacturers.json": "./devices/manufacturers.json",
		"./midi-manufacturers.json": "./devices/midi-manufacturers.json",
		"./profile.schema.json": "./devices/profile.schema.json",
		"./manufacturer.schema.json": "./devices/manufacturer.schema.json",
		"./index.schema.json": "./devices/index.schema.json",
		"./manufacturers.schema.json": "./devices/manufacturers.schema.json",
		"./midi-manufacturers.schema.json": "./devices/midi-manufacturers.schema.json",
		"./api.schema.json": "./devices/api.schema.json",
		"./api.xsd": "./devices/api.xsd",
		"./api.xsl": "./devices/api.xsl",
		"./devices/*": "./devices/*"
	},
	"files": [
		"index.js",
		"client.js",
		"devices"
	],
	"scripts": {
		"diagrams": "python scripts/generate-diagrams.py",
		"build": "node scripts/build.js && python scripts/xml_validation.py dist/api/v1",
		"validate": "node scripts/validate.js",
		"manufacturers:import": "python scripts/import-midi-manufacturers.py",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:build": "node scripts/bump-build-version.js",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version",
		"test": "npm run validate && node --test && python scripts/diagrams_test.py && python scripts/xml_test.py",
		"start": "npm run build && node scripts/server.js",
		"preview": "npm run build && npx --yes serve dist"
	},
	"devDependencies": {
		"ajv": "^8.20.0",
		"happy-dom": "^21.0.4"
	},
	"keywords": [
		"midi",
		"hardware",
		"synthesizer",
		"controller",
		"web-midi",
		"device-profiles"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/designerzen/midi-devices.git"
	},
	"homepage": "https://designerzen.github.io/midi-devices/"
}
