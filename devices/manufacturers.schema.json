{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "MIDI manufacturer directory index",
	"type": "array",
	"items": {
		"type": "object",
		"required": [
			"id",
			"name",
			"midiManufacturerIds"
		],
		"additionalProperties": false,
		"properties": {
			"id": {
				"$ref": "manufacturer.schema.json#/properties/id"
			},
			"name": {
				"type": "string",
				"minLength": 1
			},
			"midiManufacturerIds": {
				"type": "array",
				"items": {
					"$ref": "manufacturer.schema.json#/properties/midiManufacturerIds/items"
				},
				"uniqueItems": true
			}
		}
	},
	"uniqueItems": true
}
