		"novation-launchpad-x"
	],
	"portNames": [
		"LPX MIDI In",
		"LPX MIDI Out"
	],
	"description": "USB grid controller with 64 velocity-sensitive RGB pads, Note mode and Programmer mode.",
	"icon": "icon.svg",
	"documentation": [
		{
			"title": "USB MIDI interfaces",
			"url": "https://userguides.novationmusic.com/hc/en-gb/articles/24001489325330-MIDI-on-Launchpad-X"
		},
		{
			"title": "Programmer-mode MIDI layout",
			"url": "https://userguides.novationmusic.com/hc/en-gb/articles/24001475492498-Controlling-the-Launchpad-X-surface"
		}
	],
	"abilities": [
		"Custom MIDI layouts",
		"Session control",
		"Programmer mode",
		"Velocity-sensitive notes",
		"Polyphonic aftertouch"
	],
	"hardwareControls": [
		"64 pads",
		"Eight top buttons",
		"Eight scene launch buttons",
		"USB-C"
	],
	"notice": "Use the LPX MIDI interface for musical and Programmer-mode data; the LPX DAW interface is for Session integration. This profile maps the 64 grid notes, top-row CC91-98 and scene CC89 down to CC19 in Programmer mode on channel 1. Hold Session and choose the bottom scene button to enter Programmer mode. These bindings do not apply to Note, Session or edited Custom layouts. LED colours, DAW integration and polyphonic pressure are not implemented by this control map; LED output requires routing MIDI to the hardware. Diagrams are original schematics with illustrative positions, not scaled hardware drawings.",
