	"abilities": [
		"Velocity-sensitive keyboard",
		"16 pads with polyphonic aftertouch",
		"Scale and chord modes",
		"Arpeggiator",
		"Custom modes",
		"Modifier-button latching"
	],
	"hardwareControls": [
		"WHEELS / OCTAVE: Pitch, Modulation, Octave -, Octave +",
		"SCREEN / MODES: Display, Shift, Settings, Track left, Track right, Scale, Chord map, Arp, Fixed chord",
		"ENCODERS: Encoder 1, Encoder 2, Encoder 3, Encoder 4, Encoder 5, Encoder 6, Encoder 7, Encoder 8",
		"PADS: Pad 1, Pad 2, Pad 3, Pad 4, Pad 5, Pad 6, Pad 7, Pad 8, Pad 9, Pad 10, Pad 11, Pad 12, Pad 13, Pad 14, Pad 15, Pad 16",
		"WORKFLOW: Encoder bank up, Encoder bank down, Pad bank up, Pad bank down, Scene launch, Function, Capture MIDI, Quantise, Undo, Metronome, Stop, Loop, Play, Record"
	],
	"notice": "Connect via USB-C for MIDI and power, or power by USB and use the DIN MIDI output for external instruments. Configure custom assignments in Novation Components and select the matching DAW script for integrated transport. Double-press Shift to latch the modifier, reducing the need to hold two buttons. Scale and chord modes change outgoing notes. Virtual key numbers are a reference at the default chromatic range; confirm octave and transpose. Assignable wheels, pads, encoders and DAW controls remain unbound. Select the profile manually if the host does not identify it: no unverified port aliases are supplied. Diagrams are original simplified schematics, not scale drawings. Physical controls without a binding are informational; use MIDI learn for configurable assignments.",
