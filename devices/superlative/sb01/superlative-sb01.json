	"id": "superlative-sb01",
	"name": "Superlative SB01",
	"manufacturer": "Superlative",
	"manufacturerUrl": "https://playsuperlative.com/",
	"productUrl": "https://playsuperlative.com/",
	"description": "32-key analog monosynth with USB and Type A TRS MIDI, two-channel sequencing and SH-101-style synthesis.",
	"ids": [
		"superlative-sb01"
	],
	"portNames": [],
	"icon": "icon.svg",
	"documentation": [
		{
			"title": "NYU SynthAccess SH-101 / SB01 tactile guide: synthesis and performance pp. 10-17",
			"url": "https://raw.githubusercontent.com/IDMNYU/synthaccess/ee1ef12cec3a3fb6be59a7861f7df8848be2dafe/tactileSynthGuides/guides/RolandSH_101.pdf"
		},
		{
			"title": "Superlative SB01 manual: controls, connection jacks and MIDI implementation",
			"url": "https://manuals.playsuperlative.com/SB01/"
		}
	],
	"abilities": [
		"USB MIDI",
		"Type A TRS MIDI IN / OUT",
		"Analog synthesis",
		"Internal / external sequencer tracks",
		"CV / gate"
	],
	"hardwareControls": [
		"Tune / Power: Power, Tune",
		"Modulator: LFO/CLK Rate, Waveform",
		"VCO: Mod, Range, Pulse Width, PWM LFO / Manual / ENV",
		"Source mixer: Pulse, Saw, Sub Osc, Sub type, Noise",
		"VCF: Frequency, Resonance, ENV, Mod, Keyboard",
		"VCA: ENV / Gate",
		"Envelope: Gate+Trig / Gate / LFO, Attack, Decay, Sustain, Release",
		"Volume / Portamento: Volume, Portamento",
		"Bender: VCO depth, VCF depth, Joystick",
		"Performance: Portamento Auto / Off / On, Transpose L / M / H, LFO Mod",
		"Sequencer / Arpeggiator: Load / Rec, Play / Reset, Down, U+D, Up, Hold / Chord / Legato, Transpose / Latch / Rest, Internal / Write A, External / Write B, Jump, Chain, Batt / Bank Select, Shift"
	],
	"notice": "Use USB-C or 3.5 mm TRS Type A MIDI adapters. Configure separate internal and external MIDI channels and clock sources in the Superlative configuration tool or on-device menu. The maker lists the SH-101 tactile guide for SB01 as well; its modulation, VCO, source mixer, VCF, VCA, envelope and performance inventories are cross-checked and adapted to the SB01 manual. SB01-specific memory, shift, channel and connector controls are included separately. The analog synthesis sliders have no fixed CC mapping in the published MIDI chart; do not send guessed filter/envelope CCs. Pitch bend, mod wheel, vibrato CC21 and sustain CC64 are documented receive controls; sustain is also transmitted. Keyboard notes are virtual defaults starting at 48, not verified factory octave assignments. Physical layout is schematic; port aliases are unverified.",
	"controls": [
		{
			"id": "modulation",
			"label": "Mod CV / modulation receive",
			"widget": "slider",
			"default": 0,
			"cc": 1
		},
		{
			"id": "vibrato",
			"label": "Vibrato receive",
			"widget": "toggle",
			"default": 0,
			"cc": 21
		},
		{
			"id": "sustain",
			"label": "Sustain / hold",
			"widget": "toggle",
			"default": 0,
			"cc": 64
		},
		{
			"id": "pitch-bend",
			"label": "Pitch bend receive",
			"widget": "slider",
			"message": {
				"type": "pitchBend"
			},
			"min": 0,
			"max": 16383,
			"default": 8192
		}
	],
	"modes": [],
	"gui": {
		"type": "column",
		"children": [
			{
				"type": "text",
				"text": "Use USB-C or 3.5 mm TRS Type A MIDI adapters. Configure separate internal and external MIDI channels and clock sources in the Superlative configuration tool or on-device menu. The maker lists the SH-101 tactile guide for SB01 as well; its modulation, VCO, source mixer, VCF, VCA, envelope and performance inventories are cross-checked and adapted to the SB01 manual. SB01-specific memory, shift, channel and connector controls are included separately. The analog synthesis sliders have no fixed CC mapping in the published MIDI chart; do not send guessed filter/envelope CCs. Pitch bend, mod wheel, vibrato CC21 and sustain CC64 are documented receive controls; sustain is also transmitted. Keyboard notes are virtual defaults starting at 48, not verified factory octave assignments. Physical layout is schematic; port aliases are unverified."
			},
			{
				"type": "notes",
				"label": "Virtual MIDI keyboard"
			},
			{
				"type": "controls",
				"controls": [
					"modulation",
					"vibrato",
					"sustain",
					"pitch-bend"
				]
			}
		]
	},
