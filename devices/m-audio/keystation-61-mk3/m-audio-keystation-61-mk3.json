		{
			"id": "pitch-bend",
			"label": "Pitch bend",
			"message": {
				"type": "pitchBend"
			},
			"widget": "slider",
			"min": 0,
			"max": 16383,
			"default": 8192
		},
		{
			"id": "modulation",
			"label": "Modulation (CC1)",
			"cc": 1,
			"widget": "slider"
		},
		{
			"id": "sustain",
			"label": "Sustain pedal (CC64)",
			"cc": 64,
			"widget": "toggle"
		}
	],
