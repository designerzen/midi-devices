{
	"$schema": "../../profile.schema.json",
	"schemaVersion": 1,
	"id": "korg-arp-odyssey-module",
	"name": "Korg ARP Odyssey Module",
	"manufacturer": "Korg",
	"manufacturerUrl": "https://www.korg.com/",
	"productUrl": "https://www.korg.com/us/products/synthesizers/arpodyssey_module/",
	"description": "Keyboardless desktop version of Korg's duophonic ARP Odyssey reissue, played over MIDI or CV/gate.",
	"ids": [
		"korg-arp-odyssey-module"
	],
	"portNames": [],
	"icon": "icon.svg",
	"documentation": [
		{
			"title": "Korg ARP Odyssey / ARP Odyssey Module owner's manual: controls pp. 6-12, rear panel p. 13, MIDI p. 17",
			"url": "https://cdn.korg.com/us/support/download/files/2da5c4341ec598574d4af552ecb88b6e.pdf"
		},
		{
			"title": "Korg ARP Odyssey MIDI implementation chart",
			"url": "https://cdn.korg.com/us/support/download/files/7d3989df8622ee63d35fd729db12ea74.pdf"
		}
	],
	"abilities": [
		"DIN MIDI IN",
		"USB MIDI",
		"MIDI pitch bend reception",
		"Duophonic two-VCO analog synthesis",
		"Three VCF types and drive",
		"CV / GATE / TRIG in and out"
	],
	"hardwareControls": [
		"VCO-1: Frequency coarse, Frequency fine, Audio KYBD on / LF KYBD off, FM depth (pink), FM depth (yellow), Pulse width, Pulse width mod, FM source LFO, FM source S/H / ADSR, PWM source LFO / ADSR",
		"VCO-2: Frequency coarse, Frequency fine, Sync, FM depth (pink), FM depth (yellow), Pulse width, Pulse width mod, FM source LFO / S/H mixer or pedal, FM source S/H / ADSR, PWM source LFO / ADSR",
		"LFO / Sample and hold: LFO freq, S/H input level (blue), S/H input level (white), S/H output lag, S/H input source VCO-1, S/H input source noise / VCO-2, S/H trigger LFO / KYBD",
		"Audio mixer: Noise / Ring mod, VCO-1, VCO-2, Noise / Ring mod source, VCO-1 wave, VCO-2 wave",
		"VCF / HPF: VCF freq, Resonance, VCF type, Mod level (black), Mod level (yellow), Mod level (pink), Mod source KYBD CV / S/H mixer or pedal, Mod source S/H / LFO, Mod source ADSR / AR, HPF cutoff freq",
		"VCA: VCA gain, VCA level, Drive, VCA EG AR / ADSR",
		"Envelope generators: AR attack, AR release, ADSR attack, ADSR decay, ADSR sustain, ADSR release, ADSR trigger KYBD gate / LFO repeat, ADSR repeat KYBD / auto, AR trigger KYBD gate / LFO repeat",
		"Noise / Portamento: Noise generator white / pink, Portamento",
		"Rear panel controls: Power, Headphone volume, Mode switch 1-5"
	],
	"notice": "This profile is the 2015 Korg reissue, not an original 1970s ARP Odyssey; the Rev1, Rev2 and Rev3 editions share these controls and connections. Sections and rear-panel connections come from the Korg owner's manual pp. 6-13. DIN MIDI IN receives note messages only (notes 12-127, velocity ignored). The PPC pads, sliders and switches transmit no MIDI and no CC assignments exist. CV/GATE/TRIG jacks are analog, not MIDI. Consult Korg driver requirements for USB. Select the profile manually for a DIN interface. The Module has no keyboard and transmits no notes. It receives notes and pitch bend (+/-2 semitones); Reset All Controllers resets pitch bend. Set the MIDI channel with rear-panel MODE SWITCH 1-4 (factory channel 1); switch 5 sets auto power-off. The manual does not describe a Module controller section beyond the shared noise and portamento controls, so the transpose lever and PPC pads are omitted.",
