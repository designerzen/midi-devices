			"label": "Modulation",
			"cc": 1,
			"widget": "slider"
		},
		{
			"id": "cc-2",
			"label": "Joystick -Y",
			"cc": 2,
			"widget": "slider"
		},
		{
			"id": "cc-7",
			"label": "Volume",
			"cc": 7,
			"widget": "slider"
		},
		{
			"id": "cc-64",
