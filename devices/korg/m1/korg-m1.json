	"ids": [
		"korg-m1"
	],
	"portNames": [],
	"description": "PCM workstation with keyboard, programs, combinations and sequencer.",
	"icon": "icon.svg",
	"documentation": [
		{
			"title": "Korg M1: manufacturer or original documentation",
			"url": "https://www.korg.com/us/support/download/product/1/139/"
		}
	],
	"abilities": [
		"MIDI notes",
		"Pitch bend"
	],
	"hardwareControls": [
		"61 keys"
	],
	"notice": "Set the Global MIDI channel and enable the relevant MIDI filters. Combination and sequencer timbres can use separate channels. CC2 represents the joystick negative-Y controller. Program editing and multitimbral routing are not mapped. For computer use, connect MIDI OUT to interface MIDI IN; connect interface MIDI OUT to hardware MIDI IN when controlling the instrument. Port names are intentionally empty: interface or app names do not reliably identify the attached hardware. Select this profile manually. This is partial coverage, not a complete MIDI implementation. The panel is an original schematic; virtual keyboard note numbers are illustrative and require MIDI learn or octave adjustment.",
	"controls": [
		{
			"id": "pitch-bend",
			"label": "Pitch bend",
			"message": {
				"type": "pitchBend"
			},
